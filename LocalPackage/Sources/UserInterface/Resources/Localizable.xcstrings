    "runnerGalleryDescription" : {
      "comment" : "A link to the runner gallery.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Runner Gallery präsentiert und verteilt Ressourcen für eigene Runner. Finde doch einen Runner, den du gerne nutzt, oder teile sogar deine eigene Kreation mit der Community."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runner Gallery showcases and distributes resources for custom runners. Why not find a runner you love to use, or even share your own creation with the community?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runner Gallery muestra y distribuye recursos para runners personalizados. ¿Por qué no encuentras un runner que te encante usar, o incluso compartes tu propia creación con la comunidad?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runner Gallery présente et distribue des ressources pour les runners personnalisés. Pourquoi ne pas trouver un runner que vous adorez utiliser, ou même partager votre propre création avec la communauté ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runner Galleryではカスタムランナー向けのリソースが展示・配布されています。好みのランナーを見つけて使ったり、自慢のランナーを公開してみてはいかがでしょうか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runner Gallery에서는 사용자 설정 러너를 위한 리소스를 전시하고 배포합니다. 마음에 드는 러너를 찾아 사용하거나, 직접 만든 러너를 커뮤니티에 공개해 보는 건 어떨까요?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runner Gallery демонстрирует и распространяет ресурсы для пользовательских раннеров. Почему бы не найти раннера, который вам по душе, или даже не поделиться собственным творением с сообществом?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runner Gallery trưng bày và phân phối tài nguyên cho các runner tùy chỉnh. Sao bạn không tìm một runner mà mình yêu thích để sử dụng, hoặc thậm chí chia sẻ tác phẩm của riêng bạn với cộng đồng?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runner Gallery 展示并分发自定义跑者的资源。不妨找一个你喜欢的跑者来使用，或者把你自己的作品分享给社区吧？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runner Gallery 展示並分發自訂跑者的資源。何不找一個你喜歡的跑者來使用，或者把你自己的作品分享給社群呢？"
          }
        }
      }
    },
