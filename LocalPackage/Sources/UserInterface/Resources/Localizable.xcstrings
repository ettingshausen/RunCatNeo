        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausgeklappte Leiste überdeckt die eigene Touch Bar der vordersten App. Fügen Sie solche Apps zur Ausschlussliste hinzu, um sie automatisch einzuklappen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The expanded bar covers the frontmost app's own Touch Bar. Add such apps to the exclusion list to collapse the bar automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra expandida cubre la Touch Bar de la aplicación en primer plano. Añade esas aplicaciones a la lista de exclusión para replegarla automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre dépliée recouvre la Touch Bar propre de l'application au premier plan. Ajoutez ces applications à la liste d'exclusion pour la replier automatiquement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展開されたバーは最前面アプリのTouch Barの内容を覆います。そのようなアプリを除外リストに追加すると、自動的に縮みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "펼쳐진 바는 최전면 앱의 Touch Bar 내용을 가립니다. 해당 앱을 제외 목록에 추가하면 자동으로 접힙니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Развёрнутая панель перекрывает собственную Touch Bar активного приложения. Добавьте такие приложения в список исключений, чтобы панель сворачивалась автоматически."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanh đã mở rộng sẽ che phần Touch Bar của ứng dụng đang ở trước. Thêm các ứng dụng đó vào danh sách loại trừ để thanh tự động thu lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展开的指标条会覆盖前台应用自己的 Touch Bar 内容。将这类应用加入排除列表后，指标条会自动收起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展開的指標條會覆蓋前台應用自己的 Touch Bar 內容。將這類應用加入排除清單後，指標條會自動收起。"
          }
        }
      }
    },
