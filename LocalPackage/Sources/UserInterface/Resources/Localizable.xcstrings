    "aiTokenUsagePrivacyNote" : {
      "comment" : "A note explaining that AI token usage is counted from local logs only.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest die lokalen Claude Code-, ZCode- und Codex-CLI-Protokolle auf diesem Mac, um die heutigen Token zu zählen. Nichts verlässt Ihren Rechner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads the local Claude Code, ZCode and Codex CLI logs on this Mac to count today's tokens. Nothing leaves your machine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee los registros locales de Claude Code, ZCode y Codex CLI en este Mac para contar los tokens de hoy. Nada sale de tu equipo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit les journaux locaux de Claude Code, ZCode et Codex CLI sur ce Mac pour comptabiliser les tokens du jour. Rien ne quitte votre machine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMac上のClaude Code、ZCode、Codex CLIのローカルログを読み取り、今日のトークン使用量を集計します。データがMacの外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 Claude Code, ZCode, Codex CLI 로컬 로그를 읽어 오늘의 토큰 사용량을 집계합니다. 데이터는 이 Mac 밖으로 나가지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Читает локальные журналы Claude Code, ZCode и Codex CLI на этом Mac, чтобы подсчитать токены за сегодня. Данные не покидают компьютер."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc nhật ký cục bộ của Claude Code, ZCode và Codex CLI trên máy này để đếm token hôm nay. Dữ liệu không rời khỏi máy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取本机 Claude Code、ZCode 与 Codex CLI 的本地日志统计今日 Token 用量，数据不会离开这台 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讀取本機 Claude Code、ZCode 與 Codex CLI 的本機日誌統計今日 Token 用量，資料不會離開這台 Mac。"
          }
        }
      }
    },
