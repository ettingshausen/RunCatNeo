    "donationDescription" : {
      "comment" : "A description of the app's donation.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RunCat Neo stellt allen Nutzern alle Funktionen kostenlos zur Verfügung.\nDu kannst dieses Projekt unterstützen, indem du eine heiße Schokolade spendierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RunCat Neo provides all features for free to everyone.\nYou can support this project by offering hot cocoa."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RunCat Neo ofrece todas sus funciones de forma gratuita para todos.\nPuedes apoyar este proyecto invitando a un chocolate caliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RunCat Neo offre toutes ses fonctionnalités gratuitement à tout le monde.\nVous pouvez soutenir ce projet en offrant un chocolat chaud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RunCat Neo はすべての機能を無償で提供しています。\nココアを贈ることでこのプロジェクトをサポートできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RunCat Neo는 모든 기능을 누구에게나 무료로 제공합니다.\n핫초코를 선물하여 이 프로젝트를 후원할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RunCat Neo предоставляет все функции бесплатно для всех.\nВы можете поддержать этот проект, угостив горячим шоколадом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RunCat Neo cung cấp miễn phí mọi tính năng cho tất cả mọi người.\nBạn có thể ủng hộ dự án này bằng cách tặng một cốc sô-cô-la nóng."
